# Google Places API (New) — server-seitiger Key für /api/gbp-check.php.
# Datei zu .env kopieren und den echten Wert eintragen. .env wird nicht
# committet (siehe .gitignore) und darf auf dem Server außerhalb des
# Web-Roots (oberhalb von public_html) liegen, siehe public/api/gbp-check.php.
GOOGLE_PLACES_API_KEY=

# Optionales Diagnose-Token. Ist es gesetzt, kann der Betreiber im Browser
#   /api/gbp-check?diag=<DIESER-WERT>
# aufrufen und sieht die exakte Google-Fehlermeldung (z. B. Key-Einschränkung,
# nicht aktivierte Places API (New), fehlende Abrechnung). Frei wählbarer,
# geheimer Wert. Leer lassen = Diagnose deaktiviert.
GBP_DIAG_TOKEN=
