# Google Places API (New) — server-seitiger Key für /api/gbp-check.php.
# Datei zu .env kopieren und den echten Wert eintragen. .env wird nicht
# committet (siehe .gitignore) und darf auf dem Server außerhalb des
# Web-Roots (oberhalb von public_html) liegen, siehe public/api/gbp-check.php.
GOOGLE_PLACES_API_KEY=
