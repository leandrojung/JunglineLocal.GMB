# Google Places API (New) — server-seitiger Key für /api/gbp-check.php.
# Datei zu .env kopieren und den echten Wert eintragen. .env wird nicht
# committet (siehe .gitignore) und darf auf dem Server außerhalb des
# Web-Roots (oberhalb von public_html) liegen, siehe public/api/gbp-check.php.
GOOGLE_PLACES_API_KEY=

# Optionales Diagnose-Token. Ist es gesetzt, kann der Betreiber im Browser
#   /api/gbp-check?diag=<DIESER-WERT>
# aufrufen und sieht die exakte Google-Fehlermeldung (z. B. Key-Einschränkung,
# nicht aktivierte Places API (New), fehlende Abrechnung). Frei wählbarer,
# geheimer Wert. Leer lassen = Diagnose deaktiviert.
GBP_DIAG_TOKEN=

# --- Kostenbremse für die Google-Aufrufe (siehe public/api/_guard.php) ---
# Alle vier Werte sind optional. Ohne Eintrag gelten die Standardwerte,
# die in Klammern stehen.

# Anfragen pro Besucher-IP im Zeitfenster GBP_RATE_WINDOW. (5)
GBP_RATE_MAX=

# Länge des Zeitfensters in Sekunden. (600 = 10 Minuten)
GBP_RATE_WINDOW=

# Google-Aufrufe pro Tag über ALLE Besucher zusammen. Das ist die harte
# Obergrenze für die Google-Rechnung: Ist sie erreicht, wird bis zum
# nächsten Tag kein einziger Aufruf mehr gemacht. Ein vollständiger Check
# eines neuen Besuchers verbraucht bis zu 3 Aufrufe; wiederholte oder
# gleiche Suchen laufen über den Cache und kosten nichts. (200)
GBP_DAILY_BUDGET=

# Wie lange eine einmal geholte Antwort wiederverwendet wird, in Sekunden.
# (86400 = 24 Stunden)
GBP_CACHE_TTL=

# Ordner für Zähler, Tagesbudget und Cache. Leer lassen — dann wird
# automatisch .jungline-data/gbp oberhalb von public_html verwendet.
API_DATA_DIR=

# =====================================================================
# WEBSITE-GESCHWINDIGKEITS-CHECK (/api/pagespeed-check.php, /webdesign/)
# =====================================================================
# Google PageSpeed Insights API — KOSTENLOS, kein Rechnungskonto nötig
# (Standardkontingent 25.000 Anfragen/Tag). Key erzeugen: dasselbe oder ein
# neues Projekt in console.cloud.google.com → "APIs & Dienste" > "Bibliothek"
# → "PageSpeed Insights API" aktivieren → "Anmeldedaten" → API-Key erstellen.
# Empfehlung: einen EIGENEN Key anlegen (nicht GOOGLE_PLACES_API_KEY
# wiederverwenden) und ihn ausschließlich auf die "PageSpeed Insights API"
# einschränken — dann kann dieser Key nirgendwo sonst Schaden anrichten,
# selbst wenn er einmal ausliest.
GOOGLE_PAGESPEED_API_KEY=

# Optionales Diagnose-Token, analog zu GBP_DIAG_TOKEN — damit lässt sich
#   /api/pagespeed-check?diag=<DIESER-WERT>
# im Browser aufrufen und die exakte Google-Fehlermeldung sehen. Frei
# wählbarer, geheimer Wert. Leer lassen = Diagnose deaktiviert.
PAGESPEED_DIAG_TOKEN=

# --- Schutz gegen Serverlast (siehe public/api/pagespeed-check.php) ---
# Alle drei Werte sind optional. Ohne Eintrag gelten die Standardwerte, die
# in Klammern stehen. Anders als bei GBP geht es hier NICHT um eine
# Google-Rechnung (die API ist kostenlos), sondern darum, dass ein
# Durchlauf bis zu 30 Sekunden lang einen PHP-Prozess auf dem Server belegt.

# Anfragen pro Besucher-IP im Zeitfenster von 600 Sekunden. Bewusst
# niedriger als beim Profil-Check. (3)
PAGESPEED_RATE_MAX=

# Prüfungen pro Tag über ALLE Besucher zusammen — ein eigenes, von
# GBP_DAILY_BUDGET komplett unabhängiges Tagesbudget. (300)
PAGESPEED_DAILY_BUDGET=

# Wie lange ein einmal geprüftes Ergebnis wiederverwendet wird, in
# Sekunden. (86400 = 24 Stunden)
PAGESPEED_CACHE_TTL=

# =====================================================================
# TERMINBUCHUNG (/api/booking/)
# =====================================================================

# --- Mailversand -----------------------------------------------------
# SMTP-Daten des eigenen Postfachs. Hostinger hPanel → E-Mails → E-Mail-Konten
# → "Konfigurationseinstellungen". Ohne diese Werte fällt der Versand auf
# PHP mail() zurück — funktioniert, landet aber häufiger im Spam.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=Info@jungline.de
SMTP_PASS=
MAIL_FROM=Info@jungline.de
MAIL_FROM_NAME=JunglineLocal

# Wohin die Benachrichtigung über neue Buchungen geht.
OWNER_EMAIL=Info@jungline.de
OWNER_NAME=Leandro Jung — JunglineLocal

# Basis-URL der Seite; steckt in den Links der Mails.
SITE_URL=https://jungline.de

# --- Videoraum -------------------------------------------------------
# Fester Zoom-/Google-Meet-Raum. Steht in Bestätigung, Erinnerung,
# Kalendereintrag und auf der Bestätigungsseite. Leer lassen = kein
# Videolink in den Mails.
MEETING_URL=

# --- Google-Kalender-Abgleich ---------------------------------------
# Ohne diese Werte läuft die Buchung ohne Google: freie Zeiten ergeben sich
# dann nur aus den bereits über die Website gebuchten Terminen.
#
# ID des Kalenders, meist die eigene Google-Adresse.
GOOGLE_CALENDAR_ID=
# Pfad zur JSON-Schlüsseldatei des Service-Accounts. MUSS oberhalb des
# Web-Roots liegen, z. B. /home/<user>/google-kalender.json
GOOGLE_SA_KEY_FILE=
# Alternativ die beiden Werte einzeln aus der JSON-Datei:
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# --- Cronjob für Erinnerungsmails ------------------------------------
# Frei wählbarer, geheimer Wert. Ohne ihn ist /api/booking/remind gesperrt.
BOOKING_CRON_TOKEN=

# --- Optional --------------------------------------------------------
# Eigener Datenordner, falls der Standard nicht beschreibbar ist.
BOOKING_DATA_DIR=
