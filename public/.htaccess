# =========================================================================
# Caching-Strategie JunglineLocal — für Hostinger (LiteSpeed/Apache)
#
# Diese Datei liegt in public/ und wird von Vite unverändert in den
# dist/-Ordner kopiert, landet also beim Deploy im Webroot.
#
# Grundidee:
#   1. Dateien mit Content-Hash im Namen (/assets/…) ändern sich nie —
#      sie dürfen ein Jahr lang ohne Rückfrage aus dem Browser-Cache kommen.
#   2. HTML wird bei jedem Aufruf beim Server rückgefragt (Antwort ist ein
#      billiges 304 "Not Modified", solange nichts deployt wurde) —
#      dadurch ist jeder Deploy sofort für alle Besucher sichtbar.
#   3. Alles mit stabilem Pfad (Logo, Fotos, Fonts) bekommt eine mittlere
#      bis lange Lebensdauer, je nachdem wie wahrscheinlich Änderungen sind.
# =========================================================================

# ---------- 0) Kanonische Domain + saubere URL für die GBP-Check-API ----------
# /api/gbp-check bzw. /api/gbp-compare (ohne .php) intern auf die
# tatsächlichen PHP-Dateien mappen.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Kanonische Domain ohne www. Der <link rel="canonical"> jeder Seite zeigt
  # auf https://jungline.de/ — Aufrufe über www. landen sonst auf einer
  # zweiten, für Google eigenständigen Adresse. Die Regel kann nicht in einer
  # Schleife enden, weil das Ziel selbst nie auf www. matcht.
  RewriteCond %{HTTP_HOST} ^www\.jungline\.de$ [NC]
  RewriteRule ^ https://jungline.de%{REQUEST_URI} [R=301,L]

  RewriteRule ^api/gbp-check/?$ api/gbp-check.php [L]
  RewriteRule ^api/gbp-compare/?$ api/gbp-compare.php [L]

  # Terminbuchung — saubere URLs ohne .php.
  RewriteRule ^api/booking/slots/?$  api/booking/slots.php  [L]
  RewriteRule ^api/booking/book/?$   api/booking/book.php   [L]
  RewriteRule ^api/booking/cancel/?$ api/booking/cancel.php [L]
  RewriteRule ^api/booking/remind/?$ api/booking/remind.php [L]
  RewriteRule ^api/booking/ics/?$    api/booking/ics.php    [L]
  RewriteRule ^api/booking/gcal/?$   api/booking/gcal.php   [L]
  RewriteRule ^api/booking/mailtest/?$ api/booking/mailtest.php [L]
  RewriteRule ^api/booking/gtest/?$  api/booking/gtest.php  [L]
</IfModule>

# ---------- 0b) MIME-Typen verbindlich festlegen ----------
# Weiter unten wird X-Content-Type-Options: nosniff gesetzt. Das ist richtig,
# hat aber eine harte Konsequenz: Liefert der Server eine Datei mit falschem
# Content-Type aus (z. B. text/plain oder application/octet-stream, weil eine
# Endung im Server-Profil nicht hinterlegt ist), darf der Browser den Typ
# NICHT mehr erraten — er verwirft die Datei ersatzlos. Bei einem Stylesheet
# heißt das: die Seite wird komplett ungestylt angezeigt, ohne Fehlermeldung.
# Deshalb hier alle ausgelieferten Typen explizit deklarieren, statt sich auf
# die Voreinstellung des Hosters zu verlassen.
<IfModule mod_mime.c>
  AddType text/css                      .css
  AddType text/javascript               .js .mjs
  AddType application/json              .json
  AddType image/svg+xml                 .svg
  AddType image/webp                    .webp
  AddType image/avif                    .avif
  AddType font/woff2                    .woff2
  AddType font/woff                     .woff
  AddType application/xml               .xml
  AddType text/plain                    .txt
</IfModule>

# .env-Dateien dürfen unter keinen Umständen ausgeliefert werden — auch
# nicht, falls versehentlich doch mal eine im Web-Root landet.
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

# Interne Helfer der /api-Routen (_shared.php, _config.php, _store.php, …)
# sind keine Endpunkte. Sie würden beim direkten Aufruf zwar nur eine leere
# Seite liefern, aber eine Fehlkonfiguration des Servers (PHP nicht aktiv)
# würde sie im Klartext ausliefern — mitsamt der Logik dahinter.
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>

# Der Datenordner der Terminbuchung, falls er mangels Schreibrechten
# oberhalb des Web-Roots doch hier landet (siehe bkDataDir()).
RedirectMatch 404 ^/\.jungline-data(/|$)

# ---------- 1) Textinhalte komprimiert ausliefern ----------
# Brotli (LiteSpeed / Apache mit mod_brotli) — deutlich besser als gzip
# (15–25 % kleinere Bundles), besonders für Fonts und JS.
<IfModule mod_brotli.c>
  # text/javascript UND application/javascript, weil JS oben per AddType als
  # text/javascript deklariert wird (der heute gültige Standardtyp) — stünde
  # hier nur application/javascript, bliebe das JS-Bundle unkomprimiert.
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
</IfModule>
# Gzip als Fallback für Clients ohne Brotli-Support
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ---------- 2) Cache-Header ----------
# Die Regeln sind bewusst disjunkt — jede Datei fällt in genau eine
# Kategorie: HTML, robots/sitemap, Bild, Font oder gehashtes /assets/-
# Bundle (dort liegen nur CSS/JS, die keine der FilesMatch-Regeln trifft).
# Sollte Vite künftig auch Bilder/Fonts nach /assets/ hashen, greift für
# diese die jeweilige FilesMatch-Regel (FilesMatch hat bei Apache Vorrang
# vor den nackten Header-Direktiven) — das ist nur weniger aggressiv,
# nie falsch.
<IfModule mod_headers.c>

  # Vary-Header: CDN/Proxy-Cache kann Brotli- und gzip-Variante getrennt
  # speichern. Ohne diesen Header würde ein Proxy die komprimierte Variante
  # an einen Client ohne Brotli-Support ausliefern — das bräche die Seite.
  Header append Vary Accept-Encoding

  # Hinweis: Hier stand früher "Header set Connection keep-alive". Connection
  # ist ein Hop-by-Hop-Header, den ausschließlich der Server selbst setzen
  # darf. Über HTTP/2 und HTTP/3 — was Hostinger für jungline.de spricht —
  # gilt eine Antwort mit Connection-Header laut RFC 9113 als "malformed";
  # strenge Clients brechen den Stream ab (ERR_HTTP2_PROTOCOL_ERROR), während
  # Safari sie toleriert. Genau so entstehen Fehler, die nur in manchen
  # Browsern auftreten. Keep-Alive handelt der Server ohnehin selbst aus.

  # HTML: cachen erlaubt, aber vor jeder Nutzung beim Server rückfragen.
  # Unverändertes HTML wird per ETag/Last-Modified als 304 beantwortet
  # (wenige Bytes) — geändertes HTML ist sofort live.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # robots.txt & sitemap.xml: 1 Stunde reicht, Crawler fragen ohnehin
  # nicht im Sekundentakt.
  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Bilder mit stabilen Pfaden (logo.png, leandro.jpg, …): 30 Tage.
  # stale-while-revalidate: Nach Ablauf zeigt der Browser noch das alte
  # Bild und holt die neue Version im Hintergrund — nie ein leeres Bild.
  # Achtung: Wer z. B. das Logo unter gleichem Namen austauscht, muss bis
  # zu 30 Tage warten, bis es alle Stammbesucher sehen. Bei eiligen
  # Änderungen die Datei umbenennen (logo-2.png) und Verweise anpassen.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Lokal gehostete Schriften: ändern sich praktisch nie → 1 Jahr,
  # "immutable" heißt: der Browser fragt nicht einmal nach.
  # Bei einem Font-Wechsel die Datei zwingend umbenennen!
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Vite-Build-Assets: /assets/site.css und /assets/site.js haben bewusst
  # stabile Namen ohne Content-Hash (Begründung in vite.config.js). Damit
  # darf hier NICHT mehr "immutable, 1 Jahr" stehen — sonst würde ein
  # Besucher, der die Seite schon einmal geladen hat, bis zu einem Jahr
  # lang das alte Stylesheet behalten und nach einem Redesign eine kaputte
  # Seite sehen. Stattdessen wie beim HTML: cachen erlaubt, aber vor jeder
  # Nutzung rückfragen. Unverändert antwortet der Server mit 304 (wenige
  # Bytes), geändert ist sofort für alle live.
  SetEnvIf Request_URI "^/assets/" BUILD_ASSET
  Header set Cache-Control "no-cache" env=BUILD_ASSET

  # Sicherheits- und Performance-Header
  # X-Content-Type-Options: verhindert MIME-Sniffing (Sicherheit + Performance,
  # da der Browser Inhalte nicht falsch interpretieren und neu parsen muss).
  Header always set X-Content-Type-Options "nosniff"

  # Referrer-Policy: minimiert gesendete Daten an externe Ressourcen.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # X-Frame-Options: verhindert Clickjacking (Lighthouse-Empfehlung).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Permissions-Policy: nicht benötigte Browser-APIs deaktivieren.
  # Reduziert Attack-Surface und verbessert Lighthouse "Best Practices".
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---------- 3) Fallback über mod_expires ----------
# Greift nur, falls mod_headers nicht verfügbar ist; die Werte spiegeln
# die Regeln oben (ohne immutable/stale-while-revalidate, das kann
# mod_expires nicht).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS haben stabile Namen ohne Hash — sie müssen revalidiert werden,
  # sonst hängt ein wiederkehrender Besucher auf einer alten Version fest.
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
